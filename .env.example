# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - PIPELINE ETL (EXEMPLO)
# Copie este arquivo para '.env' e preencha com as suas credenciais reais.
# ==============================================================================

# String de conexão com o banco de dados PostgreSQL na nuvem
# Suporta Neon, Supabase, Render, AWS RDS, etc.
# Formato padrão: postgresql://<USUARIO>:<SENHA>@<HOST>:<PORTA>/<BANCO>?sslmode=require
DATABASE_URL=postgresql://postgres:sua_senha_secreta@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Configurações da API de Origem
API_BASE_URL=https://randomuser.me/api/
API_RESULTS_COUNT=50

# Configurações de Log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Nome da tabela de destino no PostgreSQL
DB_TABLE_NAME=contatos_processados

# Chave opcional do Google Gemini para Fallback de IA em textos desformatados
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

